// Playlist ?????: ????????? ?? ???? ? ??? ???? ????????? ????
class Playlist {
    String name;   // ??????????? ???
    Song start;    // ??????????? ????? ??? (head of linked list)

    // Constructor - ????????? ???? ???? ??? ????
    public Playlist(String name) {
        this.name = name;
        this.start = null; // ?????? ??? ??? ???
        System.out.println(name + " created.");
    }

    // ????????? ?? ??? ???? ???????? ???? ??????
    public void info() {
        System.out.println(name + " has the following songs:");
        if (start == null) {
            System.out.println("No songs in " + name + ".");
            return;
        }
        Song current = start;
        int count = 1;
        while (current != null) {
            System.out.println("Song-" + count);
            current.songInfo();
            current = current.next;
            count++;
        }
    }

    // ??????????? ???? ??? ??? ???? ????
    public void addSong(Song s) {
        if (start == null) {
            start = s;
        } else {
            Song current = start;
            while (current.next != null) {
                current = current.next;
            }
            current.next = s;
        }
        System.out.println(s.title + " added to " + name + ".");
    }

    // Overloaded addSong: ?????? ?? ???? ??? ??? ???? ????? ???
    public void addSong(Song s, boolean addToStart) {
        if (addToStart) {
            // ?????? ??? ????
            s.next = start;
            start = s;
        } else {
            // ???? ??? ???? (???? addSong ?? ???)
            addSong(s);
            return;
        }
        System.out.println(s.title + " added to " + name + ".");
    }

    // ??? ??? ???? ??????? ????
    public void playSong(String songName) {
        Song current = start;
        while (current != null) {
            if (current.title.equals(songName)) {
                System.out.println("Playing " + current.title + " by " + current.artist + ".");
                return;
            }
            current = current.next;
        }
        System.out.println(songName + " not found in " + name + ".");
    }

    // ??????? ???? ??? ??????? ???? (0-based index)
    public void playSong(int index) {
        Song current = start;
        int count = 0;
        while (current != null) {
            if (count == index) {
                System.out.println("Playing " + current.title + " by " + current.artist + ".");
                return;
            }
            current = current.next;
            count++;
        }
        System.out.println("Song at Index " + index + " not found in " + name + ".");
    }

    // ??? ???? ??? ????? ???? ????
    public void deleteSong(String songName) {
        if (start == null) return;

        // ??? ????? ??? ????? ???? ??
        if (start.title.equals(songName)) {
            System.out.println(start.title + " deleted from " + name);
            start = start.next;
            return;
        }

        Song current = start;
        while (current.next != null) {
            if (current.next.title.equals(songName)) {
                System.out.println(current.next.title + " deleted from " + name);
                current.next = current.next.next;
                return;
            }
            current = current.next;
        }
        System.out.println(songName + " not found in " + name);
    }

    // ??? ?????????? ???? ????? ???? ??? ??? ????? ???
    public void deleteSong() {
        if (start == null) return;
        if (start.next == null) {
            System.out.println(start.title + " deleted from " + name);
            start = null;
            return;
        }
        Song current = start;
        while (current.next.next != null) {
            current = current.next;
        }
        System.out.println(current.next.title + " deleted from " + name);
        current.next = null;
    }

    // boolean ?????????? ????? true ??? ????? ??? ?????, false ??? ??? ??? ?????
    public void deleteSong(boolean deleteFirst) {
        if (deleteFirst) {
            if (start == null) return;
            System.out.println("First Song Deleted!");
            start = start.next;
        } else {
            deleteSong();  // ??? ??? ????? ??? ???
        }
    }

    // ?????????? ??? ??? ???? ????
    public int totalSong() {
        int count = 0;
        Song current = start;
        while (current != null) {
            count++;
            current = current.next;
        }
        return count;
    }

    // ??? ??????????? ??????? ???? ????
    public void merge(Playlist other) {
        if (start == null) {
            start = other.start;
        } else {
            Song current = start;
            while (current.next != null) {
                current = current.next;
            }
            current.next = other.start;
        }
        System.out.println("Merge Completed!");
    }
}

